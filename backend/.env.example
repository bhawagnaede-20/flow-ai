# FLOW AI backend — environment variable examples (PLACEHOLDERS ONLY).
# Copy to .env for local use if you like, but the app reads real environment
# variables directly. NEVER commit a real .env file or credentials: .env is
# gitignored on purpose.
#
# This service has NO secrets of its own today — it serves simulated,
# in-memory data. The variables below only tune networking.

# Comma-separated exact origins allowed by CORS.
# Default when unset: http://localhost:5173,http://127.0.0.1:5173 (Vite dev).
# Production example (replace with your real frontend origin):
FLOW_AI_ALLOWED_ORIGINS=https://your-frontend.example.com

# Interface/port to bind. Hosting platforms usually inject PORT automatically;
# FLOW_AI_PORT takes precedence over PORT. Defaults: 127.0.0.1:5000 (safe
# local defaults). For platforms requiring external binding use 0.0.0.0.
FLOW_AI_HOST=0.0.0.0
FLOW_AI_PORT=5000
