# FLOW AI frontend — copy to .env.local to override (no secrets belong here).
# Vite inlines only variables prefixed with VITE_ at build time.
#
# Base URL of the Flask backend. When this variable is absent the code
# defaults to http://localhost:5000.
# The backend's CORS allow-list is http://localhost:5173 and
# http://127.0.0.1:5173 — run the Vite dev server on port 5173.
VITE_API_BASE_URL=http://localhost:5000
